---
import Card from "./Card.astro";
import { getCollection, type CollectionEntry } from "astro:content";
const allProjects: CollectionEntry<"projects">[] = await getCollection("projects");
---
<section id="Projects" class="container mx-auto scroll-mt-32 px-6">
  <div class="overflow-hidden mb-4"><div class="flex animate-scroll"><div class="flex shrink-0 whitespace-nowrap">{Array.from({ length: 10 }).map(() => <h2 class="heading text-5xl md:text-9xl uppercase mr-4 md:mr-8 -mb-2">work</h2>)}</div><div class="flex shrink-0 whitespace-nowrap" aria-hidden="true">{Array.from({ length: 10 }).map(() => <h2 class="heading text-5xl md:text-9xl uppercase mr-4 md:mr-8 -mb-2">work</h2>)}</div></div></div>
  <p class="text-xl md:text-2xl text-secondary mb-12">Killer case studies brewing ☕</p>
  {allProjects.map((project) => <Card entry={project} />)}
</section>
<style>
  @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .animate-scroll { animation: scroll 15s linear infinite; }
</style>

