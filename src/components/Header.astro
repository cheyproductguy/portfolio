---
import { SITE } from "@/consts";
const links = [
    { name: "Home", href: "/" },
    { name: "About", href: "/about" },
    { name: "Work", href: "/projects" },
    { name: "Contact", href: "/contact" },
];
---
<header class="fixed top-0 z-50 w-full">
    <div class="container mx-auto flex items-center justify-between p-6">
        <a href="/" class="font-plex text-4xl font-bold">{SITE.TITLE.toUpperCase().charAt(0)}.</a>
        <nav class="hidden space-x-5 text-secondary md:block" aria-label="Main navigation">{links.map((link) => <a href={link.href} class="mountain-link">{link.name}</a>)}</nav>
        <button id="menu-toggle" class="hamburger flex focus:outline-none md:hidden" aria-label="Toggle navigation" aria-expanded="false"><span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span></button>
    </div>
    <div id="menu-mobile" class="hidden w-screen space-x-3 bg-background p-4 text-secondary backdrop-blur-2xl md:hidden"><nav class="flex flex-col gap-4 text-2xl" aria-label="Mobile navigation">{links.map((link) => <a href={link.href} class="mountain-link">{link.name}</a>)}</nav></div>
</header>
<style>
    .mountain-link { position:relative; display:inline-block; padding:.1rem .15rem; isolation:isolate; transition:color .18s; }
    .mountain-link::before { position:absolute; z-index:-1; top:50%; left:-.12em; width:1.45em; height:.8em; transform:translate(-.25em,-50%) scale(.75); clip-path:polygon(0 100%,28% 42%,48% 78%,70% 15%,100% 100%); background:var(--color-primary); content:""; opacity:0; transition:transform .18s,opacity .18s; }
    .mountain-link:hover::before,.mountain-link:focus-visible::before { transform:translate(0,-50%) scale(1); opacity:.88; }
    .mountain-link:hover,.mountain-link:focus-visible { color:var(--color-foreground); }
    .hamburger { gap:5px; cursor:pointer; position:relative; width:24px; height:21px; padding:0; border:0; background:transparent; }
    .hamburger-line { width:24px; height:3px; background-color:var(--color-secondary,#000); transition:all .3s ease; position:absolute; left:0; }
    .hamburger-line:nth-child(1) { top:0; } .hamburger-line:nth-child(2) { top:9px; } .hamburger-line:nth-child(3) { top:18px; }
    .hamburger.active .hamburger-line:nth-child(1) { transform:rotate(45deg); top:9px; }
    .hamburger.active .hamburger-line:nth-child(2) { display:none; opacity:0; }
    .hamburger.active .hamburger-line:nth-child(3) { transform:rotate(-45deg); top:9px; }
</style>
<script>
document.addEventListener("DOMContentLoaded", () => { const menuMobile = document.getElementById("menu-mobile"); const toggle = document.getElementById("menu-toggle"); toggle?.addEventListener("click", () => { menuMobile?.classList.toggle("hidden"); toggle.classList.toggle("active"); toggle.setAttribute("aria-expanded", String(toggle.classList.contains("active"))); }); });
</script>
