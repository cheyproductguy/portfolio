---
import { SOCIALS } from "@/consts";
---
<section id="Contact" class="container mx-auto my-28 max-w-6xl scroll-mt-32 space-y-10 px-6 py-10">
    <h2 class="heading text-left text-3xl uppercase md:text-5xl">Get in Touch</h2>
    <div class="mx-auto max-w-5xl space-y-8">
        <div class="space-y-4">
            <p class="max-w-3xl text-xl md:text-2xl">Hiring? Collabs? Coffee chats? Reach out!</p>
            <p class="max-w-3xl text-xl">I'm fully authorized to work in France and Canada (remote). Open to roles in the Geneva corridor.</p>
        </div>
        <div class="flex gap-8 text-xl">
            {SOCIALS.map((link) => <a href={link.HREF} target="_blank" rel="noreferrer" class="underline transition hover:text-secondary">{link.NAME}</a>)}
        </div>
        <form class="space-y-6" action="https://formsubmit.co/cheyenne.yvr@gmail.com" method="POST">
            <input type="hidden" name="_subject" value="New portfolio contact message" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div><label for="name" class="mb-2 block font-plex text-sm font-bold uppercase tracking-wider text-secondary">Name</label><input type="text" id="name" name="name" class="w-full rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none focus:ring-2 focus:ring-primary" autocomplete="name" required /></div>
                <div><label for="email" class="mb-2 block font-plex text-sm font-bold uppercase tracking-wider text-secondary">Email</label><input type="email" id="email" name="email" class="w-full rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none focus:ring-2 focus:ring-primary" autocomplete="email" required /></div>
            </div>
            <div><label for="message" class="mb-2 block font-plex text-sm font-bold uppercase tracking-wider text-secondary">Message</label><textarea id="message" name="message" rows="6" class="w-full resize-none rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none focus:ring-2 focus:ring-primary" required></textarea></div>
            <button type="submit" class="font-plex font-bold uppercase tracking-[-2%] flex items-center justify-center bg-primary rounded-2xl py-3 px-6 sm:py-4 sm:px-10 cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition">Send Message</button>
        </form>
    </div>
</section>
