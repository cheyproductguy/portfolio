---
import { SOCIALS } from "@/consts";
---
<section id="Contact" class="container mx-auto my-24 px-6 py-10" aria-labelledby="contact-title">
    <h2 id="contact-title" class="heading mb-8 text-center text-5xl uppercase md:text-8xl">Get in Touch</h2>
    <div class="contact-content mx-auto max-w-4xl text-center">
        <p class="text-xl leading-relaxed md:text-2xl">Hiring? Collabs? Coffee chats? Reach out!</p>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-secondary md:text-xl">I'm fully authorized to work in France and Canada (remote). Open to roles in the Geneva corridor.</p>
        <div class="contact-socials my-10 flex flex-wrap justify-center gap-x-10 gap-y-4 text-base font-plex uppercase">
            {SOCIALS.map((link) => <a href={link.HREF} target="_blank" rel="noreferrer">{link.NAME}</a>)}
        </div>
        <form class="mx-auto max-w-3xl space-y-6 text-left">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="relative"><input type="text" id="name" name="name" class="peer w-full rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none placeholder-transparent" placeholder="Name" required /><label for="name" class="absolute left-4 top-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary">Name</label></div>
                <div class="relative"><input type="email" id="email" name="email" class="peer w-full rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none placeholder-transparent" placeholder="Email" required /><label for="email" class="absolute left-4 top-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary">Email</label></div>
            </div>
            <div class="relative"><textarea id="message" name="message" rows="6" class="peer w-full resize-none rounded-3xl border border-dashed border-secondary p-4 text-xl focus:outline-none placeholder-transparent" placeholder="Message" required></textarea><label for="message" class="absolute left-4 top-4 text-xl text-gray-500 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-xl peer-focus:-top-2 peer-focus:bg-background peer-focus:px-2 peer-focus:text-sm peer-focus:text-secondary">Message</label></div>
            <button type="submit" class="flex cursor-pointer items-center justify-center rounded-2xl bg-primary px-8 py-4 font-plex font-bold uppercase tracking-[-2%] transition hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground">Send Message</button>
        </form>
    </div>
</section>

<style>
    .contact-socials a { text-decoration:underline; text-decoration-color:color-mix(in srgb,var(--color-secondary) 55%,transparent); text-underline-offset:5px; transition:color .18s,text-decoration-color .18s; }
    .contact-socials a:hover,.contact-socials a:focus-visible { color:var(--color-primary); text-decoration-color:var(--color-primary); }
</style>
