---
type Testimonial = { quote: string; name: string; role: string; linkedin: string };
const testimonials: Testimonial[] = [
  {
    quote: "I had the pleasure of working with Cheyenne at BC Hydro. If she’s managing a project, you know it will be done to a high caliber. She’s dedicated, and a creative problem solver. Above all, she’s a great person and team player.",
    name: "Tiffany Kask",
    role: "Former Manager",
    linkedin: "https://ca.linkedin.com/in/tiffany-kask-a8a8022b",
  },
  {
    quote: "Cheyenne is fueled by achievement and a vibrant attitude towards learning. During our three months together: She studied product books (Inspired, Lean Product Playbook), applied her reading into work (Problem Discovery, Customer Interviews), elevated her teams (lead workshops, shared learnings), and published articles into Medium. It was absolutely inspiring to experience Cheyenne’s hustle. I encourage you to reach out and connect with her!",
    name: "Kevin Yuan",
    role: "Mentor",
    linkedin: "https://www.linkedin.com/in/kevyuan/",
  },
  {
    quote: "Cheyenne is one of the best professionals I've worked with! Not only is she super smart, driven and competent, but she also takes full ownership and accountability for her work.",
    name: "BJ Mayer",
    role: "Former Manager",
    linkedin: "https://ca.linkedin.com/in/bj-mayer-35303237",
  },
];
---
<section id="Testimonials" class="container mx-auto my-28 px-6" aria-labelledby="testimonials-title">
  <div class="mb-8">
    <h2 id="testimonials-title" class="heading text-5xl uppercase lg:text-8xl">Working with me</h2>
  </div>

  <p class="mb-10 max-w-5xl text-xl leading-relaxed text-secondary md:text-2xl">Don’t just take my word for it: hear from the people I’ve worked with.</p>

  <div class="testimonial-panel">
    <div id="testimonial-rail" class="testimonial-rail" role="region" aria-label="Testimonials">
      {testimonials.map((item) => (
        <article class="testimonial-card rounded-3xl border border-secondary/20 bg-secondary/5 p-5 sm:p-7">
          <p class="testimonial-name font-plex text-sm font-bold uppercase tracking-wider text-primary">{item.name}</p>
          <p class="testimonial-relationship mt-1 text-sm text-secondary">{item.role}</p>
          <div class="testimonial-copy mt-4 space-y-4 pb-16 text-base leading-relaxed text-secondary md:text-lg">
            <blockquote class="testimonial-quote">
              <span class="testimonial-quote-mark" aria-hidden="true">“</span>
              <span>{item.quote}</span>
            </blockquote>
          </div>
          <a class="testimonial-linkedin" href={item.linkedin} target="_blank" rel="noopener noreferrer" aria-label={item.name + " on LinkedIn"} title={item.name + " on LinkedIn"}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/>
            </svg>
          </a>
        </article>
      ))}
    </div>
    <button id="testimonial-next" type="button" class="testimonial-pagination" aria-label="Next testimonial">
      <span id="testimonial-current" aria-live="polite">01 of 03</span>
      <span aria-hidden="true">&gt;</span>
    </button>
  </div>
</section>

<style>
  .testimonial-panel { position: relative; min-width: 0; max-width: 56rem; margin-inline: auto; }
  .testimonial-rail {
    display: flex;
    min-width: 0;
    overflow: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
  }
  .testimonial-card {
    position: relative;
    display: grid;
    grid-template-columns: max-content auto minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "name linkedin ." "relationship relationship relationship" "quote quote quote";
    column-gap: .5rem;
    flex: 0 0 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    scroll-snap-align: start;
  }
  .testimonial-name { grid-area: name; min-width: 0; margin: 0; }
  .testimonial-relationship { grid-area: relationship; margin-bottom: 0; }
  .testimonial-copy { grid-area: quote; min-width: 0; }
  .testimonial-quote {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    margin: 0;
    padding: 0;
    border: 0 !important;
    font-style: normal;
  }
  .testimonial-quote-mark {
    flex: 0 0 auto;
    margin-top: .15rem;
    color: var(--color-primary);
    font-family: Georgia, serif;
    font-size: 2.5rem;
    line-height: .7;
  }
  .testimonial-linkedin {
    grid-area: linkedin;
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    align-items: center;
    justify-content: center;
    align-self: start;
    justify-self: start;
    color: var(--color-secondary);
  }
  .testimonial-linkedin svg { width: 1.2rem; height: 1.2rem; fill: currentColor; }
  .testimonial-linkedin:hover { color: var(--color-foreground); }
  .testimonial-linkedin:focus-visible { outline: 2px solid var(--color-secondary); outline-offset: 3px; }
  .testimonial-pagination {
    position: absolute;
    right: 1.5rem;
    bottom: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    border: 0;
    background: transparent;
    padding: .25rem;
    color: var(--color-secondary);
    font-family: var(--font-plex);
    font-size: .875rem;
    transition: color 160ms ease;
  }
  .testimonial-pagination:hover { color: var(--color-foreground); }
  .testimonial-pagination:focus-visible { outline: 2px solid var(--color-secondary); outline-offset: 3px; }
  .testimonial-rail::-webkit-scrollbar { display: none; }
  .testimonial-rail { scrollbar-width: none; }
  @media (prefers-reduced-motion: reduce) {
    .testimonial-rail { scroll-behavior: auto; }
    .testimonial-pagination { transition: none; }
  }
</style>

<script>
  const testimonialRail = document.querySelector<HTMLElement>("#testimonial-rail");
  const nextTestimonialButton = document.querySelector<HTMLButtonElement>("#testimonial-next");

  if (testimonialRail && nextTestimonialButton) {
    const testimonialCards = Array.from(testimonialRail.children) as HTMLElement[];
    let activeTestimonial = 0;
    let scrollEndTimer = 0;
    const currentTestimonialLabel = document.querySelector<HTMLElement>("#testimonial-current");

    const updatePagination = () => {
      const nextTestimonial = testimonialCards[(activeTestimonial + 1) % testimonialCards.length];
      if (currentTestimonialLabel) {
        currentTestimonialLabel.textContent = String(activeTestimonial + 1).padStart(2, "0") + " of " + String(testimonialCards.length).padStart(2, "0");
      }
      nextTestimonialButton.setAttribute("aria-label", "Next testimonial: " + nextTestimonial.querySelector(".testimonial-name")?.textContent);
    };

    testimonialRail.addEventListener("scroll", () => {
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(() => {
        activeTestimonial = Math.min(testimonialCards.length - 1, Math.round(testimonialRail.scrollLeft / testimonialRail.clientWidth));
        updatePagination();
      }, 100);
    }, { passive: true });

    nextTestimonialButton.addEventListener("click", () => {
      activeTestimonial = (activeTestimonial + 1) % testimonialCards.length;
      testimonialRail.scrollTo({ left: activeTestimonial * testimonialRail.clientWidth, behavior: "smooth" });
      updatePagination();
    });
  }
</script>



