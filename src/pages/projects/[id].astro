---
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const allProjects: CollectionEntry<"projects">[] =
        await getCollection("projects");

    return allProjects.filter((project) => !project.data.comingSoon).map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<Layout title={project.data.title} description={project.data.description}>
    <div class="container mx-auto space-y-8 pt-18 px-6">
        <button
            class="flex gap-2 items-center text-secondary hover:text-primary cursor-pointer pl-2 my-6"
            title="back"
            id="back-button"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-move-left-icon lucide-move-left"
                ><path d="M6 8L2 12L6 16"></path><path d="M2 12H22"></path></svg
            >
            <span>Back</span>
        </button>
        <div
            class="flex justify-between md:items-center pb-4 border-b border-dashed border-secondary gap-4 flex-col md:flex-row"
        >
            <div class="space-y-4">
                <h1 class="heading text-3xl md:text-5xl uppercase">
                    {project.data.title}
                </h1>
                {project.data.showPageDescription && <p>{project.data.subtitle || project.data.description}</p>}
            </div>            {(project.data.githubUrl || project.data.liveUrl) && <div class="flex flex-col sm:flex-row gap-4">
                {project.data.githubUrl && <a
                    href={project.data.githubUrl}
                    class="w-full sm:w-auto flex items-center justify-center bg-primary rounded-2xl py-3 px-6 sm:py-4 sm:px-10 cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition"
                >
                    Source
                </a>}
                {project.data.liveUrl && <a
                    href={project.data.liveUrl}
                    class="w-full sm:w-auto flex items-center justify-center bg-foreground text-background rounded-2xl py-3 px-6 sm:py-4 sm:px-10 cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition"
                >
                    Live Demo
                </a>}
            </div>}
        </div>

        {project.data.showHeroImage && project.data.image && (<div class="w-full lg:h-[70vh] aspect-[610/400] overflow-hidden rounded-2xl"><img src={project.data.image.url} alt={project.data.image.alt} class="w-full h-full object-contain" /></div>)}
        <article
            class="px-3 flex-2 mx-auto border-b border-dashed border-secondary mb-18"
        >
            <Content />
        </article>
    </div>

    <style is:global>
.project-impact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:1.25rem 0}
.project-impact-stat{background:#fff;border:1px solid rgba(0,0,0,.12);border-radius:14px;padding:15px 18px}
.project-impact-stat strong{display:block;font-family:var(--font-plex,"IBM Plex Mono",monospace);font-size:clamp(1.65rem,3vw,2rem);line-height:1.2;color:#111}
.project-impact-stat span{display:block;margin-top:.45rem;font:400 .82rem/1.4 var(--font-geist,Arial,sans-serif);color:#535353}
.project-impact-note{display:block;margin-top:.5rem;font-size:.72rem;line-height:1.4;color:#666}
</style>
    <script is:inline>
        document.getElementById("back-button").addEventListener("click", () => {
            window.history.back();
        });
    </script>
</Layout>
